{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_NAME": "Finance",
        "EXPO_PUBLIC_API_BASE_URL": "https://personal-expense-tracker-c2p8.onrender.com/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_NAME": "Finance",
        "EXPO_PUBLIC_API_BASE_URL": "https://personal-expense-tracker-c2p8.onrender.com/api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_NAME": "Finance",
        "EXPO_PUBLIC_API_BASE_URL": "https://personal-expense-tracker-c2p8.onrender.com/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
